# ---------------------------------------------------------------------------
# LOCAL run against the anonymized 24h Sentry pull.
#   cp .env.local.example .env
#
# Everything points at a local backend. Nothing here touches the real Sentry
# ---------------------------------------------------------------------------

SENTRY_SOURCE=fixture
SENTRY_FIXTURE_PATH=fixtures/sentry_org_issues_last_24h_anonymized.json
SENTRY_WINDOW_HOURS=24
SENTRY_ENVIRONMENTS=production

SENTRY_FIXTURE_DETAIL_PATH=fixtures/sentry_event_latest.sample.json

TOP_N=10
SELECTION_CHUNK_SIZE=25

# --- LLM -------------------------------------------------------------------
# mock   = offline, free, deterministic. Use for pipeline plumbing.
LLM_PROVIDER=mock
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=

# --- local backends --------------------------------------------------------
# Lexical, not semantic -- good enough that the whole vector-search and dedup
# path really runs offline, not good enough to judge dedup QUALITY on.
EMBEDDING_PROVIDER=hash
# JSON files in .local_state/ with a brute-force cosine scan, ranking
# neighbours exactly as BigQuery would.
STORE_BACKEND=local
GCS_BUCKET=
ARTIFACTS_DIR=artifacts
CHAT_WEBHOOK_URL=

LOG_LEVEL=INFO