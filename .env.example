# ---------------------------------------------------------------------------
# The daily triage Cloud Run Job.
# ---------------------------------------------------------------------------
GCP_PROJECT=my-gcp-project
GCP_LOCATION=europe-west2

# Sentry ingestion (the service pulls Sentry itself; no collector).
#   api      - pull sentry.io directly over HTTPS (deployed)
#   fixture  - read raw issue JSON from SENTRY_FIXTURE_PATH (local dev / demo)
SENTRY_SOURCE=api
SENTRY_BASE_URL=https://sentry.io
SENTRY_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxx
SENTRY_ORG=framestore
SENTRY_WINDOW_HOURS=24
SENTRY_FIXTURE_PATH=fixtures/sentry_issues.sample.json

SENTRY_ENVIRONMENTS=production

# Scope every query to the projects this team owns
SENTRY_TEAM=prodtools

# How many issues the top-issues agent selects for triage
TOP_N=10
# Alerts per concurrent top-issues call during the map step.
SELECTION_CHUNK_SIZE=25

LLM_PROVIDER=vertex
GEMINI_MODEL=gemini-3.5-flash
# Only for LLM_PROVIDER=gemini. Never set this in production -- Vertex uses ADC.
GEMINI_API_KEY=

# Embeddings for the vector search
EMBEDDING_PROVIDER=vertex.
EMBEDDING_MODEL=text-embedding-004

# Vector store + audit trail + run history. One database, three tables.
#   bigquery - the deployed path (dataset created by Terraform)
#   local    - JSON files in .local_state/ with a brute-force cosine scan
STORE_BACKEND=bigquery
BIGQUERY_DATASET=prodtools_triage

# PDF reports
GCS_BUCKET=
ARTIFACTS_DIR=artifacts
SIGNED_URL_DAYS=7

# Google Chat incoming webhook URL for the prodtools space
CHAT_WEBHOOK_URL=

LOG_LEVEL=INFO
